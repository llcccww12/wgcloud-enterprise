      		<if test="createTime != null" >CREATE_TIME</if>
    	</trim>
    	<trim prefix="values (" suffix=")" suffixOverrides="," >
      		<if test="id != null" >#{id},</if>
      		<if test="guid != null" >#{guid},</if>
      		<if test="systemName != null" >#{systemName},</if>
			<if test="deviceType != null" >#{deviceType},</if>
			<if test="deviceState != null" >#{deviceState},</if>
			<if test="severity != null" >#{severity},</if>
			<if test="mbOut != null" >#{mbOut},</if>
			<if test="mbIn != null" >#{mbIn},</if>
			<if test="pckOut != null" >#{pckOut},</if>
			<if test="pckIn != null" >#{pckIn},</if>
			<if test="symbolErrors != null" >#{symbolErrors},</if>
			<if test="linkRecovers != null" >#{linkRecovers},</if>
