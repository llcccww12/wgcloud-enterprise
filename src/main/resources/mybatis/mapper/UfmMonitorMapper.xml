	<insert id="insertList" parameterType="java.util.List" >
		<choose>
			<when test="_databaseId == 'oracle'">
				begin
				<foreach collection="list" item="item" index="index">
					INSERT INTO UFM_MONITOR (ID,GUID,SYSTEM_NAME,DEVICE_TYPE,DEVICE_STATE,SEVERITY,MB_OUT,MB_IN,PCK_OUT,PCK_IN,SYMBOL_ERRORS,LINK_RECOVERS,LINK_DOWNED,RCV_ERRORS,XMT_DISCARDS,MB_OUT_RATE,MB_IN_RATE,PCK_OUT_RATE,PCK_IN_RATE,ALARM_COUNT,CREATE_TIME)  VALUES
					(#{item.id},#{item.guid},#{item.systemName},#{item.deviceType},#{item.deviceState},#{item.severity},#{item.mbOut},#{item.mbIn},#{item.pckOut},#{item.pckIn},#{item.symbolErrors},#{item.linkRecovers},#{item.linkDowned},#{item.rcvErrors},#{item.xmtDiscards},#{item.mbOutRate},#{item.mbInRate},#{item.pckOutRate},#{item.pckInRate},#{item.alarmCount},#{item.createTime});
				</foreach>
				end;
			</when>
			<otherwise>
				INSERT INTO UFM_MONITOR (ID,GUID,SYSTEM_NAME,DEVICE_TYPE,DEVICE_STATE,SEVERITY,MB_OUT,MB_IN,PCK_OUT,PCK_IN,SYMBOL_ERRORS,LINK_RECOVERS,LINK_DOWNED,RCV_ERRORS,XMT_DISCARDS,MB_OUT_RATE,MB_IN_RATE,PCK_OUT_RATE,PCK_IN_RATE,ALARM_COUNT,CREATE_TIME)  VALUES
				<foreach collection="list" item="item" index="index" separator="," >
					(#{item.id},#{item.guid},#{item.systemName},#{item.deviceType},#{item.deviceState},#{item.severity},#{item.mbOut},#{item.mbIn},#{item.pckOut},#{item.pckIn},#{item.symbolErrors},#{item.linkRecovers},#{item.linkDowned},#{item.rcvErrors},#{item.xmtDiscards},#{item.mbOutRate},#{item.mbInRate},#{item.pckOutRate},#{item.pckInRate},#{item.alarmCount},#{item.createTime})
				</foreach>
			</otherwise>
		</choose>
	</insert>

	<select id="countByParams" parameterType="map" resultType="java.lang.Integer">
