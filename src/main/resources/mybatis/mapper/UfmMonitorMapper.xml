	<sql id="tableColumnList">
		ID,GUID,SYSTEM_NAME,DEVICE_TYPE,DEVICE_STATE,SEVERITY,MB_OUT,MB_IN,PCK_OUT,PCK_IN,SYMBOL_ERRORS,LINK_RECOVERS,LINK_DOWNED,RCV_ERRORS,XMT_DISCARDS,MB_OUT_RATE,MB_IN_RATE,PCK_OUT_RATE,PCK_IN_RATE,ALARM_COUNT,CREATE_TIME
	</sql>

	<sql id="queryByParams">
		<if test="systemName != null">
			<choose>
				<when test="_databaseId == 'oracle'">
					<![CDATA[ AND SYSTEM_NAME LIKE  CONCAT(CONCAT('%',#{systemName}),'%') ]]>
				</when>
				<otherwise>
					<![CDATA[ AND SYSTEM_NAME LIKE  CONCAT('%',#{systemName},'%') ]]>
				</otherwise>
			</choose>
		</if>
		<if test="severity != null">
			<![CDATA[ AND SEVERITY = #{severity} ]]>
		</if>
		<if test="deviceType != null">
			<![CDATA[ AND DEVICE_TYPE = #{deviceType} ]]>
		</if>
		<if test="deviceState != null">
			<![CDATA[ AND DEVICE_STATE = #{deviceState} ]]>
		</if>
	</sql>
	
	
	<select id="selectById" resultMap="resultMap" parameterType="java.lang.String">
		SELECT
		<include refid="tableColumnList" />
		FROM UFM_MONITOR 
		WHERE ID=#{id} 
	</select>
	
	
	<delete id="deleteByGuid" parameterType="java.lang.String">
		DELETE FROM UFM_MONITOR 
		WHERE GUID = #{guid}
	</delete>

	<delete id="deleteById" parameterType="java.lang.String">
		DELETE FROM
		UFM_MONITOR 
		WHERE ID IN
		<foreach item="item" index="index" collection="array" open="(" separator="," close=")">
			#{item}
		</foreach>
	</delete>

	<delete id="deleteByDate"  parameterType="map">
		DELETE FROM UFM_MONITOR
		<where>
			<include refid="commonSqlUtil.createTimeDelParams" />
		</where>
	</delete>

