      		<if test="guid != null" >GUID,</if>
      		<if test="systemName != null">SYSTEM_NAME,</if>
			<if test="deviceType != null">DEVICE_TYPE,</if>
			<if test="deviceState != null">DEVICE_STATE,</if>
			<if test="severity != null">SEVERITY,</if>
