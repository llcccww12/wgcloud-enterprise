<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wgcloud.mapper.KafkaMonitorMapper">
	<resultMap id="resultMap" type="com.wgcloud.entity.KafkaMonitor">
		<id column="ID" property="id" jdbcType="CHAR" />
		<result column="GROUP_ID" property="groupId" jdbcType="CHAR" />
		<result column="TOPIC_NAME" property="topicName" jdbcType="CHAR" />
		<result column="KAFKA_PARTITION" property="partition" jdbcType="CHAR" />
		<result column="KAFKA_OFFSET" property="offset" jdbcType="CHAR" />
		<result column="LAG_COUNT" property="lagCount" jdbcType="CHAR" />
		<result column="KAFKA_NAME" property="kafkaName" jdbcType="CHAR" />
		<result column="STATE" property="state" jdbcType="CHAR" />
		<result column="CREATE_TIME" property="createTime" jdbcType="TIMESTAMP" />
	</resultMap>
	
	<sql id="tableColumnList">
		ID,KAFKA_NAME,GROUP_ID,TOPIC_NAME,KAFKA_PARTITION,KAFKA_OFFSET,LAG_COUNT,CREATE_TIME,STATE
	</sql>

	<sql id="queryByParams">
		<if test="groupId != null">
			<![CDATA[ AND GROUP_ID = #{groupId} ]]>
		</if>
		<if test="state != null">
			<![CDATA[ AND STATE = #{state} ]]>
		</if>
		<if test="kafkaName != null">
			<choose>
				<when test="_databaseId == 'oracle'">
					<![CDATA[ AND KAFKA_NAME LIKE  CONCAT(CONCAT('%',#{kafkaName}),'%') ]]>
				</when>
				<otherwise>
					<![CDATA[ AND KAFKA_NAME LIKE  CONCAT('%',#{kafkaName},'%') ]]>
				</otherwise>
			</choose>
		</if>
	</sql>
	
	
	<select id="selectById" resultMap="resultMap" parameterType="java.lang.String">
		SELECT
		<include refid="tableColumnList" />
		FROM KAFKA_MONITOR 
		WHERE ID=#{id} 
	</select>
	
	
	<delete id="deleteByPrimaryKey" parameterType="java.lang.String">
		DELETE FROM KAFKA_MONITOR 
		WHERE ID = #{id}
	</delete>

	<delete id="deleteByKafkaName" parameterType="java.lang.String">
		DELETE FROM KAFKA_MONITOR WHERE KAFKA_NAME = #{kafkaName}
	</delete>

	<update id="downByKafkaName" parameterType="java.lang.String">
		UPDATE  KAFKA_MONITOR SET STATE = '2' WHERE KAFKA_NAME = #{kafkaName}
	</update>

	<delete id="deleteById" parameterType="java.lang.String">
		DELETE FROM
		KAFKA_MONITOR 
		WHERE ID IN
		<foreach item="item" index="index" collection="array" open="(" separator="," close=")">
			#{item}
		</foreach>
	</delete>

	<delete id="deleteByDate"  parameterType="map">
		DELETE FROM KAFKA_MONITOR
		<where>
			<include refid="commonSqlUtil.createTimeDelParams" />
		</where>
	</delete>

	<insert id="save" parameterType="com.wgcloud.entity.K8sMonitor">
		INSERT INTO KAFKA_MONITOR 
    	<trim prefix="(" suffix=")" suffixOverrides="," >
      		<if test="id != null" >ID,</if>
      		<if test="groupId != null" >GROUP_ID,</if>
      		<if test="topicName != null">TOPIC_NAME,</if>
			<if test="partition != null">KAFKA_PARTITION,</if>
			<if test="offset != null">KAFKA_OFFSET,</if>
			<if test="lagCount != null">LAG_COUNT,</if>
			<if test="kafkaName != null">KAFKA_NAME,</if>
			<if test="state != null">STATE,</if>
      		<if test="createTime != null" >CREATE_TIME</if>
    	</trim>
    	<trim prefix="values (" suffix=")" suffixOverrides="," >
      		<if test="id != null" >#{id},</if>
      		<if test="groupId != null" >#{groupId},</if>
      		<if test="topicName != null" >#{topicName},</if>
			<if test="partition != null" >#{partition},</if>
			<if test="offset != null" >#{offset},</if>
			<if test="lagCount != null" >#{lagCount},</if>
			<if test="kafkaName != null" >#{kafkaName},</if>
			<if test="state != null" >#{state},</if>
      		<if test="createTime != null" >#{createTime}</if>
    	</trim>
	</insert>

	<insert id="insertList" parameterType="java.util.List" >
		<choose>
			<when test="_databaseId == 'oracle'">
				begin
				<foreach collection="list" item="item" index="index">
					INSERT INTO KAFKA_MONITOR (ID,KAFKA_NAME,GROUP_ID,TOPIC_NAME,KAFKA_PARTITION,KAFKA_OFFSET,LAG_COUNT,CREATE_TIME,STATE)  VALUES
					(#{item.id},#{item.kafkaName},#{item.groupId},#{item.topicName},#{item.partition},#{item.offset},#{item.lagCount},#{item.createTime},#{item.state});
				</foreach>
				end;
			</when>
			<otherwise>
				INSERT INTO KAFKA_MONITOR (ID,KAFKA_NAME,GROUP_ID,TOPIC_NAME,KAFKA_PARTITION,KAFKA_OFFSET,LAG_COUNT,CREATE_TIME,STATE)  VALUES
				<foreach collection="list" item="item" index="index" separator="," >
					(#{item.id},#{item.kafkaName},#{item.groupId},#{item.topicName},#{item.partition},#{item.offset},#{item.lagCount},#{item.createTime},#{item.state})
				</foreach>
			</otherwise>
		</choose>
	</insert>

	<select id="countByParams" parameterType="map" resultType="java.lang.Integer">
		SELECT count(*)  FROM KAFKA_MONITOR t
		<where>
			<include refid="queryByParams" />
		</where>
	</select>


	<select id="selectAllByParams" parameterType="map" resultMap="resultMap">
		SELECT
		<include refid="tableColumnList" />
		FROM KAFKA_MONITOR t
		<where>
			<include refid="queryByParams" />
		</where>
		 ORDER BY ID DESC
	</select>
	
	<select id="selectByParams" parameterType="map" resultMap="resultMap">
		SELECT
		<include refid="tableColumnList" />
		FROM KAFKA_MONITOR
		<where>
			<include refid="queryByParams" />
		</where>
		<choose>
			<when test="orderBy !=null and orderBy != ''">
				<![CDATA[ ORDER BY ${orderBy} ${orderType}]]>
			</when>
			<otherwise>
				ORDER BY ID DESC
			</otherwise>
		</choose>
	</select>
	
	
</mapper>