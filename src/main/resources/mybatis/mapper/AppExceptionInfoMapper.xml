<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wgcloud.mapper.AppExceptionInfoMapper">
	<resultMap id="resultMap" type="com.wgcloud.entity.AppExceptionInfo">
		<id column="ID" property="id" jdbcType="CHAR" />
		<result column="HOST_NAME" property="hostname" jdbcType="CHAR" />
		<result column="APP_PID" property="appPid" jdbcType="CHAR" />
		<result column="APP_TYPE" property="appType" jdbcType="CHAR" />
		<result column="APP_NAME" property="appName" jdbcType="CHAR" />
		<result column="CPU_PER" property="cpuPer" jdbcType="DOUBLE" />
		<result column="MEM_PER" property="memPer" jdbcType="DOUBLE" />
		<result column="STATE" property="state" jdbcType="CHAR" />
		<result column="ACTIVE" property="active" jdbcType="CHAR" />
		<result column="READ_BYTES" property="readBytes" jdbcType="CHAR" />
		<result column="WRITES_BYTES" property="writesBytes" jdbcType="CHAR" />
		<result column="THREADS_NUM" property="threadsNum" jdbcType="CHAR" />
		<result column="GATHER_PID" property="gatherPid" jdbcType="CHAR" />
		<result column="GROUP_ID" property="groupId" jdbcType="CHAR" />
		<result column="APP_TIMES" property="appTimes" jdbcType="CHAR" />
		<result column="PRO_USERNAME" property="proUsername" jdbcType="CHAR" />
		<result column="CUSTOM_SHELL" property="customShell" jdbcType="CHAR" />
		<result column="WARN_LEVEL" property="warnLevel" jdbcType="CHAR" />
		<result column="NET_CONNECTIONS" property="netConnections" jdbcType="CHAR" />
		<result column="APP_CMD_LINE" property="appCmdLine" jdbcType="CHAR" />
		<result column="CREATE_TIME" property="createTime" jdbcType="TIMESTAMP" />
	</resultMap>

	<sql id="tableColumnList">
		ID,HOST_NAME, APP_PID,APP_NAME,CREATE_TIME,CPU_PER,MEM_PER,APP_TYPE,STATE,ACTIVE,READ_BYTES,WRITES_BYTES,THREADS_NUM,GATHER_PID,GROUP_ID,APP_TIMES,PRO_USERNAME,CUSTOM_SHELL,WARN_LEVEL,NET_CONNECTIONS,APP_CMD_LINE
	</sql>

	<sql id="queryByParams">
		<if test="hostname != null">
			<choose>
				<when test="_databaseId == 'oracle'">
					<![CDATA[ AND ( HOST_NAME  = #{hostname} OR APP_NAME LIKE  CONCAT(CONCAT('%',#{hostname}),'%') )]]>
				</when>
				<otherwise>
					<![CDATA[ AND ( HOST_NAME  = #{hostname} OR APP_NAME LIKE  CONCAT('%',#{hostname},'%') )]]>
				</otherwise>
			</choose>
		</if>
		<if test="cpuPer != null">
			<![CDATA[ AND CPU_PER >= #{cpuPer} ]]>
		</if>
		<if test="cpuPerLe != null">
			<![CDATA[ AND CPU_PER <= #{cpuPerLe} ]]>
		</if>
		<if test="state != null">
			<![CDATA[ AND STATE = #{state} ]]>
		</if>
		<if test="active != null">
			<![CDATA[ AND ACTIVE = #{active} ]]>
		</if>
		<if test="groupId != null">
			<include refid="commonSqlUtil.groupIdForHostNameQueryParams" />
		</if>
		<if test="account != null">
			<include refid="commonSqlUtil.hostChildAccountQueryParams" />
		</if>
	</sql>


	<select id="selectById" resultMap="resultMap" parameterType="java.lang.String">
		SELECT
		<include refid="tableColumnList" />
		FROM APP_EXCEPTION_INFO
		WHERE ID=#{id}
	</select>


	<delete id="deleteByPrimaryKey" parameterType="java.lang.String">
		DELETE FROM APP_EXCEPTION_INFO
		WHERE ID = #{id}
	</delete>


	<delete id="deleteByHostName" parameterType="java.util.List">
		DELETE FROM APP_EXCEPTION_INFO WHERE HOST_NAME IN
		<foreach item="item" collection="list" open="(" separator="," close=")">
			#{item}
		</foreach>
	</delete>

	<delete id="deleteById" parameterType="java.lang.String">
		DELETE FROM
		APP_EXCEPTION_INFO
		WHERE ID IN
		<foreach item="item" index="index" collection="array" open="(" separator="," close=")">
			#{item}
		</foreach>
	</delete>

	<delete id="deleteByDate"  parameterType="map">
		DELETE FROM APP_EXCEPTION_INFO
		<where>
			<include refid="commonSqlUtil.createTimeDelParams" />
		</where>
	</delete>

	<insert id="save" parameterType="com.wgcloud.entity.AppExceptionInfo">
		INSERT INTO APP_EXCEPTION_INFO
    	<trim prefix="(" suffix=")" suffixOverrides="," >
      		<if test="id != null" >ID,</if>
      		<if test="hostname != null" >HOST_NAME,</if>
      		<if test="appPid != null">APP_PID,</if>
      		<if test="appName != null">APP_NAME,</if>
			<if test="cpuPer != null">CPU_PER,</if>
			<if test="memPer != null">MEM_PER,</if>
			<if test="appType != null">APP_TYPE,</if>
			<if test="state != null">STATE,</if>
			<if test="active != null">ACTIVE,</if>
			<if test="readBytes != null">READ_BYTES,</if>
			<if test="writesBytes != null">WRITES_BYTES,</if>
			<if test="threadsNum != null">THREADS_NUM,</if>
			<if test="gatherPid != null">GATHER_PID,</if>
			<if test="groupId != null">GROUP_ID,</if>
			<if test="appTimes != null">APP_TIMES,</if>
			<if test="proUsername != null">PRO_USERNAME,</if>
			<if test="customShell != null">CUSTOM_SHELL,</if>
			<if test="warnLevel != null">WARN_LEVEL,</if>
			<if test="netConnections != null">NET_CONNECTIONS,</if>
			<if test="appCmdLine != null">APP_CMD_LINE,</if>
      		<if test="createTime != null" >CREATE_TIME</if>
    	</trim>
    	<trim prefix="values (" suffix=")" suffixOverrides="," >
      		<if test="id != null" >#{id},</if>
      		<if test="hostname != null" >#{hostname},</if>
      		<if test="appPid != null" >#{appPid},</if>
      		<if test="appName != null" >#{appName},</if>
			<if test="cpuPer != null" >#{cpuPer},</if>
			<if test="memPer != null" >#{memPer},</if>
			<if test="appType != null" >#{appType},</if>
			<if test="state != null" >#{state},</if>
			<if test="active != null" >#{active},</if>
			<if test="readBytes != null" >#{readBytes},</if>
			<if test="writesBytes != null" >#{writesBytes},</if>
			<if test="threadsNum != null" >#{threadsNum},</if>
			<if test="gatherPid != null" >#{gatherPid},</if>
			<if test="groupId != null" >#{groupId},</if>
			<if test="appTimes != null" >#{appTimes},</if>
			<if test="proUsername != null" >#{proUsername},</if>
			<if test="customShell != null" >#{customShell},</if>
			<if test="warnLevel != null" >#{warnLevel},</if>
			<if test="netConnections != null" >#{netConnections},</if>
			<if test="appCmdLine != null" >#{appCmdLine},</if>
      		<if test="createTime != null" >#{createTime}</if>
    	</trim>
	</insert>

	<insert id="insertList" parameterType="java.util.List" >
		<choose>
			<when test="_databaseId == 'oracle'">
				begin
				<foreach collection="list" item="item" index="index">
					INSERT INTO APP_EXCEPTION_INFO (ID,HOST_NAME, APP_PID,APP_NAME,CREATE_TIME,CPU_PER,MEM_PER,APP_TYPE,STATE,ACTIVE,READ_BYTES,WRITES_BYTES,THREADS_NUM,GATHER_PID,GROUP_ID,APP_TIMES,PRO_USERNAME,CUSTOM_SHELL,WARN_LEVEL,NET_CONNECTIONS,APP_CMD_LINE)  VALUES
					(#{item.id},#{item.hostname},#{item.appPid},#{item.appName},#{item.createTime},#{item.cpuPer},#{item.memPer},#{item.appType},#{item.state},#{item.active},#{item.readBytes},#{item.writesBytes},#{item.threadsNum},#{item.gatherPid},#{item.groupId},#{item.appTimes},#{item.proUsername},#{item.customShell},#{item.warnLevel},#{item.netConnections},#{item.appCmdLine});
				</foreach>
				end;
			</when>
			<otherwise>
				INSERT INTO APP_EXCEPTION_INFO (ID,HOST_NAME, APP_PID,APP_NAME,CREATE_TIME,CPU_PER,MEM_PER,APP_TYPE,STATE,ACTIVE,READ_BYTES,WRITES_BYTES,THREADS_NUM,GATHER_PID,GROUP_ID,APP_TIMES,PRO_USERNAME,CUSTOM_SHELL,WARN_LEVEL,NET_CONNECTIONS,APP_CMD_LINE)  VALUES
				<foreach collection="list" item="item" index="index" separator="," >
					(#{item.id},#{item.hostname},#{item.appPid},#{item.appName},#{item.createTime},#{item.cpuPer},#{item.memPer},#{item.appType},#{item.state},#{item.active},#{item.readBytes},#{item.writesBytes},#{item.threadsNum},#{item.gatherPid},#{item.groupId},#{item.appTimes},#{item.proUsername},#{item.customShell},#{item.warnLevel},#{item.netConnections},#{item.appCmdLine})
				</foreach>
			</otherwise>
		</choose>
	</insert>


	<update id="updateById" parameterType="com.wgcloud.entity.AppExceptionInfo">
		UPDATE APP_EXCEPTION_INFO
		<set>
			<if test="state != null">
				STATE = #{state},
			</if>
		</set>
		WHERE ID = #{id}
	</update>


	<select id="countByParams" parameterType="map" resultType="java.lang.Integer">
		SELECT count(*)  FROM APP_EXCEPTION_INFO t
		<where>
			<include refid="queryByParams" />
		</where>
	</select>


	<sql id="mysqlOrderBySql">
		<choose>
			<when test="_databaseId == 'mysql' and (orderBy == 'NET_CONNECTIONS' || orderBy == 'APP_TIMES' || orderBy == 'THREADS_NUM' || orderBy == 'READ_BYTES' || orderBy == 'WRITES_BYTES'|| orderBy == 'GATHER_PID')">
				<![CDATA[ ORDER BY ${orderBy} * 1 ${orderType}]]>
			</when>
			<when test="_databaseId == 'postgresql' and (orderBy == 'NET_CONNECTIONS' || orderBy == 'APP_TIMES' || orderBy == 'THREADS_NUM' || orderBy == 'READ_BYTES' || orderBy == 'WRITES_BYTES'|| orderBy == 'GATHER_PID')">
				<![CDATA[ ORDER BY CAST(${orderBy} AS float8)  ${orderType}]]>
			</when>
			<otherwise>
				<![CDATA[ ORDER BY ${orderBy} ${orderType}]]>
			</otherwise>
		</choose>
	</sql>

	<select id="selectAllByParams" parameterType="map" resultMap="resultMap">
		SELECT
		<include refid="tableColumnList" />
		FROM APP_EXCEPTION_INFO t
		<where>
			<include refid="queryByParams" />
		</where>
		 ORDER BY ID DESC
	</select>
	
	<select id="selectByParams" parameterType="map" resultMap="resultMap">
		SELECT
		<include refid="tableColumnList" />
		FROM APP_EXCEPTION_INFO
		<where>
			<include refid="queryByParams" />
		</where>
		<choose>
			<when test="orderBy !=null and orderBy != ''">
				<include refid="mysqlOrderBySql" />
			</when>
			<otherwise>
				ORDER BY ID DESC
			</otherwise>
		</choose>

	</select>
	
	
</mapper>