<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.wgcloud.mapper.HostPciInfoMapper">
	<resultMap id="resultMap" type="com.wgcloud.entity.HostPciInfo">
		<id column="ID" property="id" jdbcType="CHAR" />
		<result column="HOST_NAME" property="hostname" jdbcType="CHAR" />
		<result column="DEVICE_ID" property="deviceId" jdbcType="CHAR" />
		<result column="VENDOR_NAME" property="vendorName" jdbcType="CHAR" />
		<result column="PRODUCT_NAME" property="productName" jdbcType="CHAR" />
		<result column="CREATE_TIME" property="createTime" jdbcType="TIMESTAMP" />
	</resultMap>
	
	<sql id="tableColumnList">
		ID,HOST_NAME, DEVICE_ID,CREATE_TIME,VENDOR_NAME,PRODUCT_NAME
	</sql>
	
	<sql id="queryByParams">
		<if test="hostname != null">
			<![CDATA[ AND HOST_NAME = #{hostname} ]]>
		</if>
	</sql>

	<insert id="insertList" parameterType="java.util.List" >
		<choose>
			<when test="_databaseId == 'oracle'">
				begin
				<foreach collection="list" item="item" index="index">
					INSERT INTO HOST_PCI_INFO (ID,HOST_NAME, DEVICE_ID,CREATE_TIME,VENDOR_NAME,PRODUCT_NAME)  VALUES
					(#{item.id},#{item.hostname},#{item.deviceId},#{item.createTime},#{item.vendorName},#{item.productName});
				</foreach>
				end;
			</when>
			<otherwise>
				INSERT INTO HOST_PCI_INFO (ID,HOST_NAME, DEVICE_ID,CREATE_TIME,VENDOR_NAME,PRODUCT_NAME)  VALUES
				<foreach collection="list" item="item" index="index" separator="," >
					(#{item.id},#{item.hostname},#{item.deviceId},#{item.createTime},#{item.vendorName},#{item.productName})
				</foreach>
			</otherwise>
		</choose>
	</insert>

	<select id="selectById" resultMap="resultMap" parameterType="java.lang.String">
		SELECT
		<include refid="tableColumnList" />
		FROM HOST_PCI_INFO
		WHERE ID=#{id} 
	</select>
	
	
	<delete id="deleteByDate"  parameterType="map">
		DELETE FROM HOST_PCI_INFO
		<where>
			<include refid="commonSqlUtil.createTimeDelParams" />
		</where>
	</delete>
	
	<delete id="deleteByHostname"  parameterType="java.util.List">
			DELETE FROM HOST_PCI_INFO WHERE  HOST_NAME  IN
			<foreach item="item" collection="list" open="(" separator="," close=")">
				#{item}
			</foreach>
	</delete>
	
	<delete id="deleteByPrimaryKey" parameterType="java.lang.String">
		DELETE FROM HOST_PCI_INFO WHERE ID = #{id}
	</delete>
	
	<delete id="deleteById" parameterType="java.lang.String">
		DELETE FROM
		HOST_PCI_INFO
		WHERE ID IN
		<foreach item="item" index="index" collection="array" open="(" separator="," close=")">
			#{item}
		</foreach>
	</delete>

	<insert id="save" parameterType="com.wgcloud.entity.DiskState">
		INSERT INTO HOST_PCI_INFO
    	<trim prefix="(" suffix=")" suffixOverrides="," >
      		<if test="id != null" >ID,</if>
      		<if test="hostname != null" > HOST_NAME,</if>
      		<if test="deviceId != null">DEVICE_ID,</if>
			<if test="vendorName != null" >VENDOR_NAME,</if>
			<if test="productName != null" >PRODUCT_NAME,</if>
      		<if test="createTime != null" >CREATE_TIME</if>
    	</trim>
    	<trim prefix="values (" suffix=")" suffixOverrides="," >
      		<if test="id != null" >#{id},</if>
      		<if test="hostname != null" >#{hostname},</if>
      		<if test="deviceId != null" >#{deviceId},</if>
			<if test="vendorName != null" >#{vendorName},</if>
			<if test="productName != null" >#{productName},</if>
      		<if test="createTime != null" >#{createTime}</if>
    	</trim>
	</insert>
	
	
	  <select id="selectAllByParams" parameterType="map" resultMap="resultMap">
		SELECT
		<include refid="tableColumnList" />
		FROM HOST_PCI_INFO t
		<where>
			<include refid="queryByParams" />
		</where>
		 ORDER BY ID ASC
	</select>
	
	<select id="selectByParams" parameterType="map" resultMap="resultMap">
		SELECT
		<include refid="tableColumnList" />
		FROM HOST_PCI_INFO
		<where>
			<include refid="queryByParams" />
		</where>
		 ORDER BY ID ASC
	</select>
	
</mapper>