<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wgcloud.mapper.PasswdInfoMapper">
	<resultMap id="resultMap" type="com.wgcloud.entity.PasswdInfo">
		<id column="ID" property="id" jdbcType="CHAR" />
		<result column="HOST_NAME" property="hostname" jdbcType="CHAR" />
		<result column="HOST_ACCOUNT" property="hostAccount" jdbcType="CHAR" />
		<result column="HOST_PASSWD" property="hostPasswd" jdbcType="CHAR" />
		<result column="HOST_MARK" property="hostMark" jdbcType="CHAR" />
		<result column="HOST_REMARK" property="hostRemark" jdbcType="CHAR" />
		<result column="CREATE_TIME" property="createTime" jdbcType="TIMESTAMP" />
		<result column="ACCOUNT" property="account" jdbcType="CHAR" />
		<result column="GROUP_ID" property="groupId" jdbcType="CHAR" />
	</resultMap>

	<sql id="tableColumnList">
		ID,HOST_NAME, HOST_ACCOUNT,HOST_PASSWD,HOST_REMARK,CREATE_TIME,ACCOUNT,GROUP_ID,HOST_MARK
	</sql>

	<sql id="queryByParams">
		<if test="hostname != null">
			<choose>
				<when test="_databaseId == 'oracle'">
					<![CDATA[ AND ( HOST_NAME LIKE  CONCAT(CONCAT('%',#{hostname}),'%') OR HOST_REMARK LIKE  CONCAT(CONCAT('%',#{hostname}),'%')  OR HOST_MARK LIKE  CONCAT(CONCAT('%',#{hostname}),'%') )]]>
				</when>
				<otherwise>
					<![CDATA[ AND ( HOST_NAME LIKE  CONCAT('%',#{hostname},'%') OR HOST_REMARK LIKE  CONCAT('%',#{hostname},'%')  OR HOST_MARK LIKE  CONCAT('%',#{hostname},'%') )]]>
				</otherwise>
			</choose>
		</if>
		<if test="account != null">
			<![CDATA[ AND ACCOUNT = #{account} ]]>
		</if>
		<if test="hostMark != null">
			<![CDATA[ AND HOST_MARK = #{hostMark} ]]>
		</if>
		<if test="groupId != null">
			<include refid="commonSqlUtil.groupIdQueryParams" />
		</if>
	</sql>


	<select id="selectById" resultMap="resultMap" parameterType="java.lang.String">
		SELECT
		<include refid="tableColumnList" />
		FROM PASSWD_INFO
		WHERE ID=#{id}
	</select>


	<delete id="deleteByPrimaryKey" parameterType="java.lang.String">
		DELETE FROM PASSWD_INFO
		WHERE ID = #{id}
	</delete>

	<update id="updateToTargetAccount"  parameterType="map">
		UPDATE  PASSWD_INFO SET ACCOUNT = #{accountTarget}
		<where>
			<include refid="commonSqlUtil.updateToTargetAccountQueryParams" />
		</where>
	</update>

	<delete id="deleteById" parameterType="java.lang.String">
		DELETE FROM
		PASSWD_INFO
		WHERE ID IN
		<foreach item="item" index="index" collection="array" open="(" separator="," close=")">
			#{item}
		</foreach>
	</delete>

	<insert id="save" parameterType="com.wgcloud.entity.PasswdInfo">
		INSERT INTO PASSWD_INFO
    	<trim prefix="(" suffix=")" suffixOverrides="," >
      		<if test="id != null" >ID,</if>
      		<if test="hostname != null" >HOST_NAME,</if>
      		<if test="hostAccount != null">HOST_ACCOUNT,</if>
      		<if test="hostPasswd != null">HOST_PASSWD,</if>
			<if test="hostRemark != null">HOST_REMARK,</if>
			<if test="hostMark != null">HOST_MARK,</if>
			<if test="account != null">ACCOUNT,</if>
			<if test="groupId != null">GROUP_ID,</if>
      		<if test="createTime != null" >CREATE_TIME</if>
    	</trim>
    	<trim prefix="values (" suffix=")" suffixOverrides="," >
      		<if test="id != null" >#{id},</if>
      		<if test="hostname != null" >#{hostname},</if>
      		<if test="hostAccount != null" >#{hostAccount},</if>
      		<if test="hostPasswd != null" >#{hostPasswd},</if>
			<if test="hostRemark != null" >#{hostRemark},</if>
			<if test="hostMark != null" >#{hostMark},</if>
			<if test="account != null" >#{account},</if>
			<if test="groupId != null" >#{groupId},</if>
      		<if test="createTime != null" >#{createTime}</if>
    	</trim>
	</insert>


	<update id="updateById" parameterType="com.wgcloud.entity.PasswdInfo">
		UPDATE PASSWD_INFO
		<set>
			<if test="hostname != null">
				HOST_NAME = #{hostname},
			</if>
			<if test="hostAccount != null">
				HOST_ACCOUNT = #{hostAccount},
			</if>
			<if test="hostPasswd != null">
				HOST_PASSWD = #{hostPasswd},
			</if>
			<if test="hostRemark != null">
				HOST_REMARK = #{hostRemark},
			</if>
			<if test="hostMark != null">
				HOST_MARK = #{hostMark},
			</if>
			<if test="groupId != null">
				GROUP_ID = #{groupId},
			</if>
			<if test="createTime != null">
				CREATE_TIME = #{createTime}
			</if>
		</set>
		WHERE ID = #{id}
	</update>

	<select id="countByParams" parameterType="map" resultType="java.lang.Integer">
		SELECT count(*)  FROM PASSWD_INFO t
		<where>
			<include refid="queryByParams" />
		</where>
	</select>


	<select id="selectAllByParams" parameterType="map" resultMap="resultMap">
		SELECT
		<include refid="tableColumnList" />
		FROM PASSWD_INFO t
		<where>
			<include refid="queryByParams" />
		</where>
		 ORDER BY CREATE_TIME DESC
	</select>
	
	<select id="selectByParams" parameterType="map" resultMap="resultMap">
		SELECT
		<include refid="tableColumnList" />
		FROM PASSWD_INFO
		<where>
			<include refid="queryByParams" />
		</where>
		 ORDER BY CREATE_TIME DESC
	</select>
	
	
</mapper>